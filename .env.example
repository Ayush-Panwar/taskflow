# Copy to .env to override the Docker Compose defaults. Never commit .env.

# Database
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=change-me

# JWT signing secret, at least 32 bytes. Generate one with: openssl rand -base64 48
# If blank, a random key is used and tokens stop working when the backend restarts.
JWT_SECRET=

# Time zone that decides what "today" means for overdue tasks and due date checks.
TASKFLOW_TIME_ZONE=UTC

# Sample users and tasks. Turn this off for anything real.
TASKFLOW_SEED_ENABLED=true
TASKFLOW_SEED_PASSWORD=demo12345

# Ports on your machine
FRONTEND_PORT=3000
BACKEND_PORT=8080
